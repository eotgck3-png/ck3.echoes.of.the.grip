# ── OS & Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

.vscode/
*.code-workspace
.idea/

# ── CK3 Runtime Artifacts ────────────────────────────────────────────────────
# Never commit these — they are auto-generated by the engine or tools
*.log
*.tmp

# Paradox launcher / playset files (machine-specific)
launcher-settings.json
.launcher-cache/

# ── Binary Assets (track intentionally or use Git LFS) ───────────────────────
# DDS textures, OGG music, and TGA files are large binaries.
# Uncomment and use Git LFS if you want to track them:
# *.dds
# *.tga
# *.ogg
# *.wav
#
# For now, ignore them to keep the repo lean:
*.dds
*.tga
*.ogg
*.wav
*.bmp
*.png
*.jpg
*.jpeg

# ── Build / Release Artifacts ────────────────────────────────────────────────
dist/
release/
*.zip
*.tar.gz

# ── CK3 Tiger Output ─────────────────────────────────────────────────────────
tiger-output/
tiger_*.txt

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.orig
*~
