
# Generated terrain art / bakes (see gfx/map/terrain/README.md)
gfx/map/terrain/*.dds
# Exception (2026-10-04): the structure bakes are irreproducible. The 10-01 bake came from a
# --source image that is no longer anywhere, so they are tracked inputs, not outputs.
# Do not rerun build_terrain_hybrid.py over them; see docs/pitfalls.md.
!gfx/map/terrain/eotg_structure_*.dds
# colormap.dds (09-25) predates the only committed build_colormap.py and no args reproduce it.
!gfx/map/terrain/colormap.dds
gfx/map/terrain/*.tga
gfx/map/terrain/masks/
docs/tools/__pycache__/
gfx/models/buildings/holdings/*.dds

# Generated by docs/tools/build_terrain_hybrid.py alongside the terrain DDS above.
# pdxterrain.shader is hand-written and IS versioned; this lookup table is not.
gfx/FX/eotg_terrain_params.fxh

# Preview renders from docs/tools/preview_terrain_fx.py - regenerable, not sources.
docs/tools/preview_*.png
docs/tools/terrain_preview.png

# Generated map-object placements (gfx/map/map_object_data/generated/) are TRACKED on purpose:
# they reproduce byte-for-byte from docs/tools/strip_map_objects.py (verified 2026-10-04) and are small.

# Generated marker binaries: rebuilt by docs/tools/obj_to_pdxmesh.py and build_marker_assets.py
# from eotg_marker_source.obj, which IS tracked.
gfx/models/buildings/eotg_markers/*.dds
