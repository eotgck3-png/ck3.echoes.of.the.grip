# MOD(eotg) GENERATED by docs/tools/build_marker_assets.py - do not hand-edit.
# One mesh per HOLDING TYPE, three material slots: 0 the projector plinth (metal,
# trims glowing in the holding's colour), 1 that type's glowing emblem, 2 the beam
# that makes the emblem read as something the plinth casts.
# The silhouette and the colour both say what kind of holding it is.

pdxmesh = {
	name = "eotg_marker_castle_mesh"
	file = "eotg_marker_castle.mesh"

	meshsettings = {
		name = "eotg_markerShape"
		index = 0
		texture_diffuse = "eotg_marker_castle_plinth_diffuse.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "eotg_marker_plinth_properties.dds"
		shader = "snap_to_terrain"
	}
	meshsettings = {
		name = "eotg_markerShape"
		index = 1
		texture_diffuse = "eotg_marker_castle_diffuse.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "eotg_marker_glow_properties.dds"
		shader = "snap_to_terrain"
	}
	meshsettings = {
		name = "eotg_markerShape"
		index = 2
		texture_diffuse = "eotg_marker_castle_beam.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "eotg_marker_glow_properties.dds"
		shader = "snap_to_terrain_alpha_to_coverage"
	}
}

