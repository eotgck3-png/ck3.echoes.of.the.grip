version="0.1.0"
tags={
	"Total Conversion"
	"Events"
	"Historical"
	"Bookmark"
}
name="Echoes of the Grip"
supported_version="1.19.*"

# ── Total Conversion: replace vanilla content entirely ────────────────────────
# Without these, vanilla CK3 characters, cultures, religions and history will
# load alongside mod content in the same game session.
replace_path="history/characters"
replace_path="history/titles"
replace_path="history/provinces"
replace_path="history/struggles"
replace_path="history/wars"

replace_path="common/culture/cultures"

# CK3 1.19 religion paths (renamed from religions/holy_sites/religion_families)
replace_path="common/religion/religion_types"
replace_path="common/religion/religion_family_types"
replace_path="common/religion/holy_site_types"

replace_path="common/bookmarks/bookmarks"
replace_path="common/dynasties"
